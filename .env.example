# Copiar a .env y completar. NUNCA subir .env al repositorio.
POSTGRES_USER=rag
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LARGA
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIAR_MINIO_PASSWORD_LARGA
MINIO_BUCKET=documentos
RAG_API_KEY=CAMBIAR_API_KEY_ALEATORIA_LARGA
# Firma los enlaces públicos /files/ (distinta de RAG_API_KEY): openssl rand -hex 32
FILES_SIGNING_SECRET=CAMBIAR_SECRETO_DE_FIRMA_LARGO
# URL pública donde nginx expone /files/ (en el servidor: https://piec.ulagos.cl)
FILES_PUBLIC_BASE_URL=http://localhost:8000
# Vigencia de los enlaces firmados, en segundos (60–86400)
FILES_URL_TTL=900
OPENAI_API_KEY=sk-reemplazar
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
