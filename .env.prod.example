# Producción. Copiar a .env.prod y usar con: docker compose --env-file .env.prod up --build -d
# (en el servidor, junto con ../docker-proxy/overrides/rag-circular.yaml; ver docker-proxy/README.md).
# NUNCA subir .env.prod al repositorio.
#
# Las contraseñas de Postgres y MinIO se fijan al crear los volúmenes: cambiarlas
# después rompe el inicio de sesión en lugar de cambiar la contraseña.
POSTGRES_USER=rag
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_LARGA
MINIO_ROOT_USER=CAMBIAR_USUARIO_MINIO
MINIO_ROOT_PASSWORD=CAMBIAR_MINIO_PASSWORD_LARGA
MINIO_BUCKET=documentos

# Debe ser igual a RAG_API_KEY en docker-proxy/overrides/.env.encircular. openssl rand -hex 32
RAG_API_KEY=CAMBIAR_API_KEY_ALEATORIA_LARGA

# Enlaces públicos /files/ (ver docs/api/files.md)
# Secreto de firma exclusivo de producción, distinto de RAG_API_KEY. openssl rand -hex 32
FILES_SIGNING_SECRET=CAMBIAR_SECRETO_DE_FIRMA_LARGO
# Origen público donde nginx expone /files/.
FILES_PUBLIC_BASE_URL=https://piec.ulagos.cl
# Vigencia de los enlaces en segundos (60–86400).
FILES_URL_TTL=900

OPENAI_API_KEY=sk-reemplazar
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# No cambiar sin regenerar la tabla chunks (cambia la dimensión del vector).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
